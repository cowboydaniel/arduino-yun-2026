#!/bin/sh /etc/rc.common
# If the Yun is set to join a Wi-Fi network but can't within the timeout
# (arduino.@arduino[0].wifi_fallback_timeout, default 60 s), bring up the
# setup access point so the board stays reachable. The next boot tries the
# network again.

START=19
USE_PROCD=1

boot() {
	# Before the network starts: undo a fallback from the last boot, and
	# make the Wi-Fi sections match the saved role.
	yun-wifi retry
	yun-wifi sync --no-reload
	start
}

start_service() {
	[ "$(yun-wifi status)" = client ] || return 0
	procd_open_instance
	procd_set_param command /bin/sh -c '
		timeout=$(uci -q get arduino.@arduino[0].wifi_fallback_timeout)
		timeout=${timeout:-60}
		[ "$timeout" -gt 0 ] || exit 0
		waited=0
		while [ $waited -lt $timeout ]; do
			ifstatus wwan 2>/dev/null | jsonfilter -q -e "@[\"ipv4-address\"][0].address" >/dev/null && exit 0
			sleep 5
			waited=$((waited + 5))
		done
		logger -t yun "could not join Wi-Fi in ${timeout}s, starting the setup access point"
		yun-wifi fallback
	'
	procd_close_instance
}
