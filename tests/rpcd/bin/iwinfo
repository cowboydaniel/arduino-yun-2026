#!/bin/sh
# Fake "iwinfo -j <dev> <cmd>", printing the JSON the ucode iwinfo in
# OpenWrt 25.12's wifi-scripts prints (see its usr/share/ucode/iwinfo.uc).
[ "$1" = -j ] || { echo "the Yun Panel only uses iwinfo -j" >&2; exit 1; }
case "$3" in
info) cat <<'X'
[ { "iface": "lo", "ssid": "Workshop", "mac": "90:A2:DA:F0:54:D2", "mode": "Client",
    "channel": 6, "freq": "2.437", "htmode": "HT20", "txpower": 17, "noise": -95,
    "signal": -61, "bitrate": "65.0", "encryption": "WPA2-PSK (CCMP)", "quality": 49,
    "hwmode": "bgn", "phy": "phy0" } ]
X
;;
assoclist) cat <<'X'
{ "11:22:33:44:55:66": { "mac": "11:22:33:44:55:66", "signal": -61, "noise": -95, "snr": 34 } }
X
;;
scan) cat <<'X'
[
 { "bssid": "11:22:33:44:55:66", "ssid": "Workshop", "channel": 6, "dbm": -61, "quality": 49, "mode": "Master",
   "crypto": { "group": "CCMP", "pair": [ "CCMP" ], "key_mgmt": [ "WPA PSK" ] } },
 { "bssid": "AA:BB:CC:DD:EE:FF", "ssid": "Cafe <b>Guest</b>", "channel": 11, "dbm": -80, "quality": 30, "mode": "Master" },
 { "bssid": "00:00:00:00:00:01", "ssid": "Newer", "channel": 1, "dbm": -70, "quality": 40, "mode": "Master",
   "crypto": { "group": "CCMP", "pair": [ "CCMP" ], "key_mgmt": [ "WPA PSK", "SAE" ] } },
 { "bssid": "00:00:00:00:00:02", "ssid": "Office", "channel": 1, "dbm": -70, "quality": 40, "mode": "Master",
   "crypto": { "group": "CCMP", "pair": [ "CCMP" ], "key_mgmt": [ "802.1x" ] } },
 { "bssid": "00:00:00:00:00:03", "channel": 3, "dbm": -75, "quality": 35, "mode": "Master",
   "crypto": { "group": "CCMP", "pair": [ "CCMP" ], "key_mgmt": [ "WPA PSK" ] } }
]
X
;;
*) exit 1 ;;
esac
