diff --git a/target/linux/ath79/dts/ar9331_arduino_yun-2026.dts b/target/linux/ath79/dts/ar9331_arduino_yun-2026.dts
new file mode 100644
index 0000000..bbc6de4
--- /dev/null
+++ b/target/linux/ath79/dts/ar9331_arduino_yun-2026.dts
@@ -0,0 +1,240 @@
+// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
+
+#include "ar9331.dtsi"
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/leds/common.h>
+#include <dt-bindings/mtd/partitions/uimage.h>
+
+/ {
+	model = "Arduino Yun (2026 layout)";
+	compatible = "arduino,yun-2026", "qca,ar9331";
+
+	chosen {
+		bootargs = "console=ttyATH0,250000";
+	};
+
+	ahb {
+		apb {
+			pinmux_extended: pinmux@18040030 {
+				compatible = "pinctrl-single";
+				reg = <0x18040030 0x4>;
+
+				pinctrl-single,bit-per-mux;
+				pinctrl-single,register-width = <32>;
+				pinctrl-single,function-mask = <0x1>;
+				#pinctrl-cells = <2>;
+
+				enable_gpio11: pinmux_enable_gpio11 {
+					pinctrl-single,bits = <0x0 0x200 0x200>;
+				};
+			};
+
+			pinmux_bootstrap: pinmux@180600ac {
+				compatible = "pinctrl-single";
+				reg = <0x180600ac 0x4>;
+
+				pinctrl-single,bit-per-mux;
+				pinctrl-single,register-width = <32>;
+				pinctrl-single,function-mask = <0x1>;
+				#pinctrl-cells = <2>;
+
+				enable_gpio26_gpio27: pinmux_enable_gpio26_gpio27 {
+					pinctrl-single,bits = <0x0 0x40000 0x40000>;
+				};
+			};
+		};
+	};
+
+	leds {
+		compatible = "gpio-leds";
+
+		wlan {
+			function = LED_FUNCTION_WLAN;
+			color = <LED_COLOR_ID_BLUE>;
+			gpios = <&gpio 0 GPIO_ACTIVE_HIGH>;
+			linux,default-trigger = "phy0tpt";
+		};
+
+		usb {
+			function = LED_FUNCTION_USB;
+			color = <LED_COLOR_ID_WHITE>;
+			gpios = <&gpio 1 GPIO_ACTIVE_HIGH>;
+			trigger-sources = <&hub_port>;
+			linux,default-trigger = "usbport";
+		};
+	};
+
+	keys {
+		compatible = "gpio-keys";
+
+		config {
+			label = "config";
+			linux,code = <BTN_0>;
+			gpios = <&gpio 20 GPIO_ACTIVE_LOW>;
+		};
+	};
+
+	gpio-export {
+		compatible = "gpio-export";
+
+		gpio_spi_enable {
+			gpio-export,name = "yun:oe:spi";
+			gpio-export,output = <0>;
+			gpios = <&gpio 21 GPIO_ACTIVE_HIGH>;
+		};
+
+		gpio_handshake_enable {
+			gpio-export,name = "yun:oe:hs";
+			gpio-export,output = <0>;
+			gpios = <&gpio 22 GPIO_ACTIVE_HIGH>;
+		};
+
+		gpio_uart_enable {
+			gpio-export,name = "yun:oe:uart";
+			gpio-export,output = <0>;
+			gpios = <&gpio 23 GPIO_ACTIVE_LOW>;
+		};
+	};
+
+	reg_usb_vbus: reg_usb_vbus {
+		compatible = "regulator-fixed";
+		regulator-name = "usb_vbus";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		enable-active-high;
+	};
+};
+
+&pinmux {
+	pinctrl-names = "default";
+	pinctrl-0 = <&jtag_disable_pins &switch_led_disable_pins>;
+};
+
+&switch_led_disable_pins {
+	pinctrl-single,bits = <0x0 0x80 0xf8>;
+};
+
+&pinmux_extended {
+	pinctrl-names = "default";
+	pinctrl-0 = <&enable_gpio11>;
+};
+
+&pinmux_bootstrap {
+	pinctrl-names = "default";
+	pinctrl-0 = <&enable_gpio26_gpio27>;
+};
+
+&usb {
+	status = "okay";
+
+	dr_mode = "host";
+	vbus-supply = <&reg_usb_vbus>;
+};
+
+&usb_phy {
+	status = "okay";
+};
+
+&spi {
+	status = "okay";
+
+	flash@0 {
+		compatible = "jedec,spi-nor";
+		reg = <0>;
+		spi-max-frequency = <50000000>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "u-boot";
+				reg = <0x0 0x40000>;
+				read-only;
+			};
+
+			partition@40000 {
+				label = "u-boot-env";
+				reg = <0x40000 0x10000>;
+				read-only;
+			};
+
+			/*
+			 * The stock U-Boot always boots the uImage at 0x9fea0000,
+			 * which was the kernel partition of the original Linino
+			 * layout. That slot is only 1280k, so it now holds a small
+			 * lzma-loader that starts the real kernel from the front
+			 * of the firmware partition. The kernel uImage carries the
+			 * squashfs magic so that the stock Linino sysupgrade
+			 * accepts the image as-is.
+			 */
+			partition@50000 {
+				compatible = "openwrt,uimage", "denx,uimage";
+				openwrt,ih-magic = <0x68737173>;
+				label = "firmware";
+				reg = <0x50000 0xe50000>;
+			};
+
+			partition@ea0000 {
+				label = "loader";
+				reg = <0xea0000 0x140000>;
+				read-only;
+			};
+
+			partition@fe0000 {
+				label = "nvram";
+				reg = <0xfe0000 0x10000>;
+			};
+
+			partition@ff0000 {
+				label = "art";
+				reg = <0xff0000 0x10000>;
+				read-only;
+
+				nvmem-layout {
+					compatible = "fixed-layout";
+					#address-cells = <1>;
+					#size-cells = <1>;
+
+					cal_art_1000: calibration@1000 {
+						reg = <0x1000 0x440>;
+					};
+
+					macaddr_art_1002: macaddr@1002 {
+						compatible = "mac-base";
+						reg = <0x1002 0x6>;
+						#nvmem-cell-cells = <1>;
+					};
+				};
+			};
+		};
+	};
+};
+
+&eth0 {
+	status = "okay";
+
+	/*
+	 * The Ethernet MAC is the Wi-Fi MAC from art with bit 29 set, as on the
+	 * stock firmware (0x80000 higher when that bit is clear, which is what
+	 * boards have). board.d sets the exact value in /etc/config/network too.
+	 */
+	nvmem-cells = <&macaddr_art_1002 0x80000>;
+	nvmem-cell-names = "mac-address";
+};
+
+&eth1 {
+	status = "okay";
+
+	compatible = "syscon", "simple-mfd";
+};
+
+&wmac {
+	status = "okay";
+
+	nvmem-cells = <&cal_art_1000>;
+	nvmem-cell-names = "calibration";
+};
diff --git a/target/linux/ath79/generic/base-files/etc/board.d/02_network b/target/linux/ath79/generic/base-files/etc/board.d/02_network
index 6be9d44..d780d00 100644
--- a/target/linux/ath79/generic/base-files/etc/board.d/02_network
+++ b/target/linux/ath79/generic/base-files/etc/board.d/02_network
@@ -134,6 +134,11 @@ ath79_setup_interfaces()
 	zyxel,nwa1123-ni)
 		ucidef_set_interface_lan "eth0"
 		;;
+	arduino,yun-2026)
+		# The Ethernet jack is a DHCP client, as on the stock firmware.
+		# The lan network (Wi-Fi only) is set up by the yun-base package.
+		ucidef_set_interface_wan "eth0"
+		;;
 	airtight,c-75)
 		ucidef_add_switch "switch0" \
 			"0u@eth0" "2:wan" "3:lan" "6u@eth1"
@@ -651,6 +656,11 @@ ath79_setup_macs()
 		lan_mac=$(macaddr_setbit $base_mac 29)
 		[ $lan_mac = $base_mac ] && lan_mac=$(macaddr_unsetbit $base_mac 29)
 		;;
+	arduino,yun-2026)
+		base_mac=$(mtd_get_mac_binary art 0x1002)
+		wan_mac=$(macaddr_setbit $base_mac 29)
+		[ $wan_mac = $base_mac ] && wan_mac=$(macaddr_unsetbit $base_mac 29)
+		;;
 	avm,fritz1750e|\
 	avm,fritz450e|\
 	avm,fritzdvbc)
diff --git a/target/linux/ath79/image/Makefile b/target/linux/ath79/image/Makefile
index 1918a8a..f722650 100644
--- a/target/linux/ath79/image/Makefile
+++ b/target/linux/ath79/image/Makefile
@@ -49,6 +49,17 @@ define Build/append-loader-okli-uimage
 	cat "$(KDIR)/loader-$(word 1,$(1)).uImage" >> "$@"
 endef
 
+# Arguments: <size>
+# Like pad-to, but pads with 0xff (erased flash) instead of zeros.
+define Build/pad-to-ff
+	let \
+		size="$$(stat -c%s $@)" \
+		pad="$(call exp_units,$(1)) - size"; \
+	[ $$pad -ge 0 ] || { echo "$@ is larger than $(1)" >&2; exit 1; }; \
+	[ $$pad -eq 0 ] || \
+	dd if=/dev/zero bs=$$pad count=1 2>/dev/null | tr '\000' '\377' >> $@
+endef
+
 define Build/relocate-kernel
 	rm -rf $@.relocate
 	$(CP) ../../generic/image/relocate $@.relocate
diff --git a/target/linux/ath79/image/generic.mk b/target/linux/ath79/image/generic.mk
index c5eb589..02b2fd6 100644
--- a/target/linux/ath79/image/generic.mk
+++ b/target/linux/ath79/image/generic.mk
@@ -386,6 +386,39 @@ define Device/arduino_yun
 endef
 TARGET_DEVICES += arduino_yun
 
+# Arduino Yun, installed in place over the stock Linino firmware.
+#
+# The stock U-Boot is kept and always boots whatever uImage sits at 0xea0000
+# (the old Linino kernel slot). An lzma-loader lives there and boots the real
+# kernel from the start of the firmware partition at 0x50000. The kernel uImage
+# uses the squashfs magic, which is what the stock Linino sysupgrade checks for.
+#
+# linino-upgrade.bin is the whole 0x50000-0xfe0000 region, gzip'd, and is
+# flashed from stock Linino with its own sysupgrade. The gap between the rootfs
+# and the loader is padded with 0xff, so the settings that the stock mtd writes
+# at the 0xdeadc0de marker are followed by erased flash.
+#
+# sysupgrade.bin is used for later updates and only rewrites the firmware
+# partition.
+define Device/arduino_yun-2026
+  $(Device/loader-okli-uimage)
+  SOC := ar9331
+  DEVICE_VENDOR := Arduino
+  DEVICE_MODEL := Yun
+  DEVICE_VARIANT := 2026 layout
+  DEVICE_PACKAGES := kmod-usb-chipidea2 kmod-usb-ledtrig-usbport \
+	kmod-usb-storage block-mount -swconfig
+  LOADER_FLASH_OFFS := 0x050000
+  LOADER_KERNEL_MAGIC := 0x68737173
+  KERNEL := kernel-bin | append-dtb | lzma | uImage lzma -M 0x68737173
+  IMAGE_SIZE := 14656k
+  IMAGES += linino-upgrade.bin
+  IMAGE/linino-upgrade.bin := append-kernel | pad-to $$$$(BLOCKSIZE) | \
+	append-rootfs | pad-rootfs | check-size | pad-to-ff 14656k | \
+	append-loader-okli-uimage $(1) | gzip
+endef
+TARGET_DEVICES += arduino_yun-2026
+
 define Device/aruba_ap-105
   SOC := ar7161
   DEVICE_VENDOR := Aruba
diff --git a/target/linux/ath79/image/lzma-loader/src/board.c b/target/linux/ath79/image/lzma-loader/src/board.c
index ffe33cb..6555319 100644
--- a/target/linux/ath79/image/lzma-loader/src/board.c
+++ b/target/linux/ath79/image/lzma-loader/src/board.c
@@ -28,8 +28,35 @@
 #define UART_READ(r)		READREG(UART_BASE + 4 * (r))
 #define UART_WRITE(r,v)		WRITEREG(UART_BASE + 4 * (r), (v))
 
+/*
+ * The AR9330/AR9331 have their own UART, not a 16550: one data register,
+ * with TX_CSR set when it can take the next character. Waiting for the
+ * 16550's THRE bit there would hang the loader at its first printf.
+ */
+#define RESET_REG_REV_ID	0xb8060090
+#define REV_ID_MAJOR_MASK	0xfff0
+#define REV_ID_MAJOR_AR9330	0x0110
+#define REV_ID_MAJOR_AR9331	0x1110
+
+#define AR933X_UART_DATA	0xb8020000
+#define AR933X_UART_TX_CSR	(1 << 9)
+
+static int is_ar933x(void)
+{
+	unsigned int id = READREG(RESET_REG_REV_ID) & REV_ID_MAJOR_MASK;
+
+	return id == REV_ID_MAJOR_AR9330 || id == REV_ID_MAJOR_AR9331;
+}
+
 void board_putc(int ch)
 {
+	if (is_ar933x()) {
+		while ((READREG(AR933X_UART_DATA) & AR933X_UART_TX_CSR) == 0);
+		WRITEREG(AR933X_UART_DATA, AR933X_UART_TX_CSR | (unsigned char)ch);
+		while ((READREG(AR933X_UART_DATA) & AR933X_UART_TX_CSR) == 0);
+		return;
+	}
+
 	while (((UART_READ(UART_LSR)) & UART_LSR_THRE) == 0);
 	UART_WRITE(UART_TX, ch);
 	while (((UART_READ(UART_LSR)) & UART_LSR_THRE) == 0);
