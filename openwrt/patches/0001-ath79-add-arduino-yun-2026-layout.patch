 	aruba,ap-105|\
 	aruba,ap-175|\
 	asus,rp-ac51|\
@@ -646,7 +647,8 @@ ath79_setup_macs()
 	engenius,ens202ext-v1)
 		label_mac=$(mtd_get_mac_binary art 0x1002)
 		;;
-	arduino,yun)
+	arduino,yun|\
