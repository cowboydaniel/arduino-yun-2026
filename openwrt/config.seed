CONFIG_TARGET_ath79=y
CONFIG_TARGET_ath79_generic=y
CONFIG_TARGET_ath79_generic_DEVICE_arduino_yun-2026=y
# Not used on a Yun, which joins networks rather than routing for them:
# PPP/PPPoE (DSL uplinks), the IPv6 router service, and uboot-envtools
# (its partition is read-only here, and it only complained at boot).
# CONFIG_PACKAGE_ppp is not set
# CONFIG_PACKAGE_ppp-mod-pppoe is not set
# CONFIG_PACKAGE_odhcpd-ipv6only is not set
# CONFIG_PACKAGE_uboot-envtools is not set
# Kernel features OpenWrt turns on for routers with 16 MB of flash, which a
# Yun never uses: no package in the image needs them. The kernel stays in
# RAM, so each one costs memory as well as flash (MPTCP alone is ~214 KB
# compressed).
# Multipath TCP
# CONFIG_KERNEL_MPTCP is not set
# VRF (layer 3 master devices)
# CONFIG_KERNEL_NET_L3_MASTER_DEV is not set
# Multicast routing (needs a routing daemon like pimd, which isn't installed)
# CONFIG_KERNEL_IP_MROUTE is not set
# CONFIG_KERNEL_IPV6_MROUTE is not set
# IPv6 segment routing
# CONFIG_KERNEL_IPV6_SEG6_LWTUNNEL is not set
# Per-connection conntrack timeouts (firewall4 doesn't use them)
# CONFIG_KERNEL_NF_CONNTRACK_TIMEOUT is not set
# cgroup controllers for RDMA hardware, several CPUs, real-time and disk
# throttling (the Yun has one CPU and no RDMA or rate-limited disks)
# CONFIG_KERNEL_CGROUP_RDMA is not set
# CONFIG_KERNEL_CPUSETS is not set
# CONFIG_KERNEL_RT_GROUP_SCHED is not set
# CONFIG_KERNEL_CFS_BANDWIDTH is not set
# CONFIG_KERNEL_BLK_DEV_THROTTLING is not set
# urngd feeds the kernel random number generator, which since Linux 5.18
# seeds itself (jitter entropy): one less daemon in RAM.
# CONFIG_PACKAGE_urngd is not set
